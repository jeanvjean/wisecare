      "item": [
        {
          "name": "User Signup",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\", \n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"country\": \"nigeria\",\n  \"phoneNumber\": \"+2341234567890\",\n  \"deliveryMethod\": \"sms\"\n}"
            },
            "url": {
              "raw": "{{SUPABASE_URL}}/functions/v1/signup",
              "host": [
                "{{SUPABASE_URL}}"
              ],
              "path": [
                "functions",
                "v1",
                "signup"
              ]
            },
            "description": "Create a new user account and send email verification OTP. Optional: include phoneNumber and deliveryMethod ('sms' or 'whatsapp') to also trigger phone verification."
          },
          "response": [
            {
              "name": "Success Response",
              "originalRequest": {
                "method": "POST",
                "header": [],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"user@example.com\",\n \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"country\": \"nigeria\"\n}"
                },
                "url": {
                  "raw": "{{SUPABASE_URL}}/functions/v1/signup",
                  "host": [
                    "{{SUPABASE_URL}}"
                  ],
                  "path": [
                    "functions",
                    "v1",
                    "signup"
                  ]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "cookie": [],
              "body": "{\n  \"message\": \"User created, OTP sent to email\",\n  \"otp_id\": \"uuid-string\"\n}"
            }
          ]
        },
        {
          "name": "Resend Signup OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
