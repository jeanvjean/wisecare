              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"assertion\": {\n    \"id\": \"credential-id\",\n    \"rawId\": \"base64-raw-id\",\n    \"type\": \"public-key\",\n    \"response\": {\n      \"clientDataJSON\": \"base64-client-data\",\n      \"authenticatorData\": \"base64-auth-data\",\n      \"signature\": \"base64-signature\",\n      \"userHandle\": \"base64-user-handle\"\n    }\n  }\n}"
