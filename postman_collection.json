    {
      "name": "WebAuthn Authentication",
      "item": [
        {
          "name": "Get WebAuthn Registration Options",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ACCESS_TOKEN}}"
              }
            ],
            "url": {
              "raw": "{{SUPABASE_URL}}/functions/v1/webauthn-register",
              "host": ["{{SUPABASE_URL}}"],
              "path": ["functions", "v1", "webauthn-register"]
            },
            "description": "Get WebAuthn registration options for biometric authentication setup"
          }
        },
        {
          "name": "Register WebAuthn Credential",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ACCESS_TOKEN}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"credential\": {\n    \"id\": \"credential-id\",\n    \"rawId\": \"base64-raw-id\",\n    \"type\": \"public-key\",\n    \"response\": {\n      \"clientDataJSON\": \"base64-client-data\",\n      \"attestationObject\": \"base64-attestation\"\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{SUPABASE_URL}}/functions/v1/webauthn-register",
              "host": ["{{SUPABASE_URL}}"],
              "path": ["functions", "v1", "webauthn-register"]
            },
            "description": "Register a WebAuthn credential for biometric authentication"
          }
        },
        {
          "name": "Get WebAuthn Authentication Options",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\"\n}"
            },
            "url": {
              "raw": "{{SUPABASE_URL}}/functions/v1/webauthn-authenticate/options",
              "host": ["{{SUPABASE_URL}}"],
              "path": ["functions", "v1", "webauthn-authenticate", "options"]
            },
            "description": "Get WebAuthn authentication options for sign-in"
          }
        },
        {
          "name": "Authenticate with WebAuthn",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"assertion\": {\n    \"id\": \"credential-id\",\n    \"rawId\": \"base64-raw-id\",\n    \"type\": \"public-key\",\n    \"response\": {\n      \"clientDataJSON\": \"base64-client-data\",\n      \"authenticatorData\": \"base64-auth-data\",\n      \"signature\": \"base64-signature\",\n      \"userHandle\": \"base64-user-handle\"\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{SUPABASE_URL}}/functions/v1/webauthn-authenticate",
              "host": ["{{SUPABASE_URL}}"],
              "path": ["functions", "v1", "webauthn-authenticate"]
            },
            "description": "Authenticate user with WebAuthn biometric credential"
          }
        }
      ]
    },
