                "header": [],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"phoneNumber\": \"+2341234567890\",\n  \"deliveryMethod\": \"whatsapp\",\n  \"email\": \"user@example.com\"\n}"
                },
                "url": {
                  "raw": "{{SUPABASE_URL}}/functions/v1/send-phone-otp",
                  "host": ["{{SUPABASE_URL}}"],
                  "path": ["functions", "v1", "send-phone-otp"]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
